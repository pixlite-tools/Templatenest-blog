---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blog" description="Guides and honest advice on choosing and using Notion, Canva, and PowerPoint templates.">
  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-clay-dark">The blog</p>
    <h1 class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">
      Guides for people who love a good template
    </h1>
    <p class="mt-3 max-w-xl text-base text-ink-soft">
      No fluff — just practical advice on Notion systems, Canva kits, and PowerPoint decks, from
      the people who design them.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
