---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../consts";
---

<BaseLayout title="Page not found">
  <section class="mx-auto flex max-w-xl flex-col items-center px-6 py-32 text-center">
    <p class="font-display text-6xl font-semibold text-clay-dark">404</p>
    <h1 class="mt-4 font-display text-2xl font-semibold text-ink">This page wandered off.</h1>
    <p class="mt-3 text-sm text-ink-soft">
      Maybe it's a template that got renamed, or a link that's past its due date.
    </p>
    <a
      href={url("/")}
      class="mt-8 rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper hover:bg-clay-dark"
    >
      Back to TemplateNest
    </a>
  </section>
</BaseLayout>
