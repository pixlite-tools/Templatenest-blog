---
import type { CollectionEntry } from "astro:content";
import { url } from "../consts";

interface Props {
  post: CollectionEntry<"blog">;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, category } = post.data;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});

const palette: Record<string, string> = {
  Notion: "from-[#5c6b4f] to-[#3f4a37]",
  Canva: "from-[#b5502f] to-[#7c3620]",
  Planning: "from-[#8a6a3f] to-[#5c4527]",
  Design: "from-[#4f5b6b] to-[#333c47]",
  Guide: "from-[#6f5c8a] to-[#463a5c]",
  Comparison: "from-[#3f7a6b] to-[#294f45]",
};
const gradient = palette[category] ?? palette.Guide;
---

<a
  href={url(`blog/${post.id}/`)}
  class={`group flex flex-col overflow-hidden rounded-3xl border border-line bg-paper transition-all hover:-translate-y-1 hover:shadow-xl ${featured ? "md:col-span-2 md:flex-row" : ""}`}
>
  <div
    class={`relative flex h-40 shrink-0 items-center justify-center bg-gradient-to-br ${gradient} bg-grain ${featured ? "md:h-auto md:w-2/5" : ""}`}
  >
    <span class="font-display text-4xl font-semibold text-paper/90">{category}</span>
  </div>
  <div class="flex flex-1 flex-col justify-center p-6">
    <p class="text-xs font-medium uppercase tracking-wider text-clay-dark">{category} · {formattedDate}</p>
    <h3 class={`mt-2 font-display font-semibold text-ink group-hover:text-clay-dark ${featured ? "text-2xl" : "text-lg"}`}>
      {title}
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-ink-soft">{description}</p>
    <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-clay-dark">
      Read the post
      <svg width="14" height="10" viewBox="0 0 14 10" fill="none" class="transition-transform group-hover:translate-x-1">
        <path d="M0 5h13M8 1l5 4-5 4" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </span>
  </div>
</a>
