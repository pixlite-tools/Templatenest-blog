---
import Mark from "./Mark.astro";
import { SITE_TAGLINE, ETSY_URL, PAYHIP_URL, NAV_LINKS } from "../consts";

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-paper-dim">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr]">
      <div class="max-w-sm">
        <Mark />
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">{SITE_TAGLINE}</p>
      </div>

      <div>
        <p class="font-display text-sm font-semibold uppercase tracking-wide text-ink">Explore</p>
        <ul class="mt-3 space-y-2">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-ink-soft hover:text-clay-dark">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="font-display text-sm font-semibold uppercase tracking-wide text-ink">Shop the templates</p>
        <ul class="mt-3 space-y-2">
          <li>
            <a
              href={ETSY_URL}
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="text-sm text-ink-soft hover:text-clay-dark"
            >
              Etsy Shop ↗
            </a>
          </li>
          <li>
            <a
              href={PAYHIP_URL}
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="text-sm text-ink-soft hover:text-clay-dark"
            >
              Payhip Store ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-line pt-6 text-xs text-ink-soft sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} TemplateNest. All rights reserved.</p>
      <p>Designed for people who like their tools as tidy as their to-do lists.</p>
    </div>
  </div>
</footer>
