---
import BaseLayout from "./BaseLayout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags } = post.data;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
---

<BaseLayout title={title} description={description} article={true}>
  <article class="mx-auto max-w-2xl px-6 py-16">
    <p class="text-xs font-medium uppercase tracking-wider text-clay-dark">
      {category}
    </p>
    <h1 class="mt-3 font-display text-3xl font-semibold leading-tight text-ink sm:text-4xl">
      {title}
    </h1>
    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-soft">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      {updatedDate && <span>· Updated {updatedDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</span>}
    </div>

    <div class="prose-nest mt-10">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-2 border-t border-line pt-6">
          {tags.map((tag) => (
            <span class="rounded-full border border-line bg-paper-dim px-3 py-1 text-xs text-ink-soft">
              #{tag}
            </span>
          ))}
        </div>
      )
    }

    <div class="mt-14">
      <CtaBanner />
    </div>
  </article>
</BaseLayout>
